<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>socialdrinks</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>socialdrinks-frontend</artifactId>

    <properties>
        <node.version>22.1.0</node.version>
        <npm.version>10.7.0</npm.version>
    </properties>

    <build>
        <plugins>

            <!-- Frontend Build mit Node & NPM -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.1</version>
                <executions>
                    <execution>
                        <id>install node and npm</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>v${node.version}</nodeVersion>
                            <npmVersion>${npm.version}</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Spring Boot Plugin deaktivieren -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>

        <profile>
            <id>spring-doc</id>

            <build>
                <plugins>
                    <!-- 1) Artefakt-Datei ins target/ kopieren -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>copy-openapi</id>
                                <phase>generate-sources</phase>
                                <goals><goal>copy</goal></goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>com.example</groupId>
                                            <artifactId>socialdrinks-cocktails</artifactId>
                                            <classifier>openapi</classifier>
                                            <type>json</type>
                                            <destFileName>openapi.json</destFileName>
                                            <outputDirectory>${project.build.directory}</outputDirectory>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 2) TypeScript generieren: nur Modelle ODER kompletter Client -->
                    <plugin>
                        <groupId>org.openapitools</groupId>
                        <artifactId>openapi-generator-maven-plugin</artifactId>
                        <version>7.16.0</version>
                        <executions>
                            <execution>
                                <id>gen-ts</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <inputSpec>${project.build.directory}/openapi.json</inputSpec>

                                    <!-- Variante A: kompletter Client -->
                                    <generatorName>typescript-axios</generatorName>

                                    <!-- Variante B: nur Modelle
                            <generatorName>typescript-fetch</generatorName>
                            <configOptions>
                              <modelOnly>true</modelOnly>
                            </configOptions>
                            -->

                                    <output>${project.build.directory}/generated/ts</output>
                                    <configOptions>
                                        <supportsES6>true</supportsES6>
                                        <withSeparateModelsAndApi>true</withSeparateModelsAndApi>
                                        <modelPropertyNaming>camelCase</modelPropertyNaming>
                                        <enumPropertyNaming>original</enumPropertyNaming>
                                        <useSingleRequestParameter>true</useSingleRequestParameter>
                                        <apiPackage>api</apiPackage>
                                        <modelPackage>model</modelPackage>
                                    </configOptions>
                                    <strictSpec>true</strictSpec>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>

            <dependencies>
                <!-- zieht cocktails:openapi.json wie ein normales Artefakt -->
                <dependency>
                    <groupId>com.example</groupId>
                    <artifactId>socialdrinks-cocktails</artifactId>
                    <version>1.0-SNAPSHOT</version>
                    <classifier>openapi</classifier>
                    <type>json</type>
                </dependency>
            </dependencies>

        </profile>

    </profiles>

</project>
